rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPERS ─────────────────────────────────────────────
    // IMPORTANTE: usar exists() para comprobar existencia. get() sobre un
    // documento inexistente falla TODA la evaluación (deny), en vez de
    // devolver null como cabría esperar.
    function esProfesional() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/profesionales/$(request.auth.uid));
    }

    // Solo se llama tras esProfesional() (short-circuit &&), doc garantizado.
    function miFranquicia() {
      return get(/databases/$(database)/documents/profesionales/$(request.auth.uid)).data.franquiciaId;
    }

    function esDesarrollador() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/desarrolladores/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/desarrolladores/$(request.auth.uid)).data.activo == true;
    }

    function franquiciaValida(franquiciaId) {
      return franquiciaId is string && franquiciaId.size() > 0 &&
        exists(/databases/$(database)/documents/franquicias/$(franquiciaId));
    }

    // El documento (ya existente) pertenece a mi franquicia
    function recursoDeMiFranquicia() {
      return resource.data.franquiciaId == miFranquicia();
    }

    // El documento entrante (create) pertenece a mi franquicia
    function datoDeMiFranquicia() {
      return request.resource.data.franquiciaId == miFranquicia();
    }

    // En update: el documento actual es de mi franquicia y el resultado no la cambia
    function updateDeMiFranquicia() {
      return recursoDeMiFranquicia() && datoDeMiFranquicia();
    }

    // ─── CONFIGURACIÓN PÚBLICA (lectura para todos; escritura solo profesional de la franquicia o desarrollador) ───

    match /sedes/{document} {
      allow read: if true;
      allow create: if (esProfesional() && datoDeMiFranquicia()) || esDesarrollador();
      allow update: if (esProfesional() && updateDeMiFranquicia()) || esDesarrollador();
      allow delete: if (esProfesional() && recursoDeMiFranquicia()) || esDesarrollador();
    }

    match /horarios/{document} {
      allow read: if true;
      allow create: if (esProfesional() && datoDeMiFranquicia()) || esDesarrollador();
      allow update: if (esProfesional() && updateDeMiFranquicia()) || esDesarrollador();
      allow delete: if (esProfesional() && recursoDeMiFranquicia()) || esDesarrollador();
    }

    match /excepciones/{document} {
      allow read: if true;
      allow create: if (esProfesional() && datoDeMiFranquicia()) || esDesarrollador();
      allow update: if (esProfesional() && updateDeMiFranquicia()) || esDesarrollador();
      allow delete: if (esProfesional() && recursoDeMiFranquicia()) || esDesarrollador();
    }

    match /tipos_consulta/{document} {
      allow read: if true;
      allow create: if (esProfesional() && datoDeMiFranquicia()) || esDesarrollador();
      allow update: if (esProfesional() && updateDeMiFranquicia()) || esDesarrollador();
      allow delete: if (esProfesional() && recursoDeMiFranquicia()) || esDesarrollador();
    }

    // Profesionales: lectura pública (el paciente los necesita); escritura restringida.
    // Un profesional puede editar su propio documento. Desarrollador tiene acceso completo.
    match /profesionales/{document} {
      allow read: if true;
      allow create: if (esProfesional() && datoDeMiFranquicia()) || esDesarrollador();
      allow update: if (esProfesional() && (request.auth.uid == document || updateDeMiFranquicia())) || esDesarrollador();
      allow delete: if esDesarrollador();
    }

    // ─── CITAS Y PACIENTES ───────────────────────────────────
    // El paciente (auth anónima, sin doc en profesionales) puede crear y leer.
    // El profesional solo accede a los datos de SU franquicia.
    // Desarrollador tiene acceso completo a todas las franquicias.
    // IMPORTANTE: allow list no puede usar resource (undefined en queries).
    // El aislamiento de datos se maneja vía _withFranquicia() en la app.
    match /citas/{document} {
      allow get: if (request.auth != null && !esProfesional()) || (esProfesional() && recursoDeMiFranquicia()) || esDesarrollador();
      allow list: if request.auth != null;
      allow create: if (!esProfesional() && franquiciaValida(request.resource.data.franquiciaId))
                 || (esProfesional() && datoDeMiFranquicia())
                 || esDesarrollador();
      allow update: if (esProfesional() && updateDeMiFranquicia()) || esDesarrollador();
      allow delete: if (esProfesional() && recursoDeMiFranquicia()) || esDesarrollador();
    }

    match /pacientes/{document} {
      allow get: if (request.auth != null && !esProfesional()) || (esProfesional() && recursoDeMiFranquicia()) || esDesarrollador();
      allow list: if request.auth != null;
      allow create: if (!esProfesional() && franquiciaValida(request.resource.data.franquiciaId))
                 || (esProfesional() && datoDeMiFranquicia())
                 || esDesarrollador();
      allow update: if (esProfesional() && updateDeMiFranquicia()) || esDesarrollador();
      allow delete: if (esProfesional() && recursoDeMiFranquicia()) || esDesarrollador();
    }

    // ─── NOTIFICACIONES (solo profesional de la franquicia o desarrollador) ──
    match /notificaciones/{document} {
      allow get: if (esProfesional() && recursoDeMiFranquicia()) || esDesarrollador();
      allow list: if esProfesional() || esDesarrollador();
      allow create: if (esProfesional() && datoDeMiFranquicia()) || esDesarrollador();
      allow update: if (esProfesional() && updateDeMiFranquicia()) || esDesarrollador();
      allow delete: if (esProfesional() && recursoDeMiFranquicia()) || esDesarrollador();
    }

    // ─── VERSIÓN DE LA APP ───────────────────────────────────
    match /app_version/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ─── ADMIN (solo desarrolladores) ────────────────────────
    match /franquicias/{document} {
      allow read: if true;
      allow write: if esDesarrollador();
    }

    match /desarrolladores/{document} {
      allow read: if esDesarrollador() || (request.auth != null && request.auth.uid == document);
      allow write: if esDesarrollador();
    }

    // ─── AUDIT LOG (solo desarrollador) ──────────────────────
    match /audit_log/{document} {
      allow read: if esDesarrollador();
      allow create: if request.auth != null;
      allow delete: if false;
    }
  }
}
